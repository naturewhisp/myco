# EditorConfig configuration for Myco Android Project
# Visual Studio / Android Studio / IntelliJ Code Analysis & Formatting Rules
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{kt,kts}]
indent_size = 4
continuation_indent_size = 4
# Avoid wildcard imports (Visual Studio & Android Kotlin convention)
ij_kotlin_name_count_to_use_star_import = 999
ij_kotlin_name_count_to_use_star_import_for_members = 999
# Trailing commas for clean diffs
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{xml,xsd}]
indent_size = 4
continuation_indent_size = 8

[*.{gradle,groovy}]
indent_size = 4

[*.{json,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off
