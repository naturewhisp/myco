#!/bin/sh
# Pre-commit hook: Verify Swift-Kotlin contracts and non-optional bindings
echo "Verifying Swift-Kotlin cross-platform contracts..."
if command -v python >/dev/null 2>&1; then
    python -m unittest discover -s scripts -p test_check_swift_contracts.py && python scripts/check_swift_contracts.py
elif command -v python3 >/dev/null 2>&1; then
    python3 -m unittest discover -s scripts -p test_check_swift_contracts.py && python3 scripts/check_swift_contracts.py
elif command -v py >/dev/null 2>&1; then
    py -3 -m unittest discover -s scripts -p test_check_swift_contracts.py && py -3 scripts/check_swift_contracts.py
else
    echo "ERROR: Python not found; Swift contract verification is required."
    exit 1
fi

if [ $? -ne 0 ]; then
    echo "ERROR: Swift-Kotlin contract verification failed! Aborting commit."
    exit 1
fi
