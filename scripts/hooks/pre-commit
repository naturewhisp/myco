#!/bin/sh
# Pre-commit hook: Verify Swift-Kotlin contracts and non-optional bindings
echo "Verifying Swift-Kotlin cross-platform contracts..."
if command -v python >/dev/null 2>&1; then
    python scripts/check_swift_contracts.py
elif command -v python3 >/dev/null 2>&1; then
    python3 scripts/check_swift_contracts.py
elif command -v py >/dev/null 2>&1; then
    py -3 scripts/check_swift_contracts.py
else
    echo "Warning: Python not found, skipping Swift contract check."
    exit 0
fi

if [ $? -ne 0 ]; then
    echo "ERROR: Swift-Kotlin contract verification failed! Aborting commit."
    exit 1
fi
